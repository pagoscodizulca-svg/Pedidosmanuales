{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "oxc"],
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    "*.cjs",
    "check-db.js",
    "fix_layout.js",
    "list-models.js",
    "seed-users.js"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off",
    "react/set-state-in-effect": "off"
  }
}
